{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastpresspages.github.io/launchgrade/schema/report.schema.json",
  "title": "LaunchGrade report",
  "description": "The JSON emitted by `launchgrade --json` and by `report.json` in --out directories. Describes one scan of one launch page at one point in time. Compatibility policy: this is a public contract. Additive fields may appear at any release; breaking changes to existing fields require a major version bump. Consumers should ignore unknown fields.",
  "type": "object",
  "required": ["tool", "version", "generatedAt", "url", "grade", "score", "label", "counts", "categories", "topFixes", "checks"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL of this schema, so editors can validate the file directly."
    },
    "tool": { "const": "launchgrade" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+",
      "description": "LaunchGrade version that produced this report."
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "url": {
      "type": "string",
      "description": "Final URL after redirects — the page that was actually scanned."
    },
    "requestedUrl": {
      "type": "string",
      "description": "URL as requested, before redirects. Present when the request was redirected (or returned an error page after a redirect)."
    },
    "httpStatus": {
      "type": "integer",
      "minimum": 0,
      "maximum": 599,
      "description": "HTTP status of the final HTML response (0 when the page was fetched via a non-HTTP fallback)."
    },
    "responseMs": {
      "type": "integer",
      "minimum": 0
    },
    "htmlBytes": {
      "type": "integer",
      "minimum": 0
    },
    "grade": {
      "type": "string",
      "pattern": "^(A\\+|A|A-|B\\+|B|B-|C\\+|C|C-|D\\+|D|D-|F)$"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "label": {
      "type": "string",
      "description": "One-line verdict, e.g. “Launch-ready”."
    },
    "counts": {
      "type": "object",
      "required": ["pass", "warn", "fail", "info", "error", "skipped", "total"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "short", "score", "weight", "counts"],
        "additionalProperties": false,
        "properties": {
          "key": { "enum": ["conversion", "trust", "technical", "seo", "social", "a11y", "agent"] },
          "label": { "type": "string" },
          "short": { "type": "string" },
          "score": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 100,
            "description": "0–100 or null when the category had no scored checks."
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Share of the overall grade, percent."
          },
          "counts": {
            "type": "object",
            "required": ["pass", "warn", "fail"],
            "additionalProperties": false,
            "properties": {
              "pass": { "type": "integer", "minimum": 0 },
              "warn": { "type": "integer", "minimum": 0 },
              "fail": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "topFixes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "status", "title", "detail", "fix", "impact"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["warn", "fail", "error"] },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "fix": { "type": "string" },
          "impact": {
            "type": "number",
            "description": "Relative impact on the weighted grade."
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "title", "status", "weight", "detail", "fix"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "category": { "enum": ["conversion", "trust", "technical", "seo", "social", "a11y", "agent"] },
          "title": { "type": "string" },
          "status": { "enum": ["pass", "warn", "fail", "error", "info", "skipped"] },
          "weight": { "type": "integer", "minimum": 0 },
          "detail": { "type": "string" },
          "fix": { "type": "string", "description": "Empty when the check passed or is informational." }
        }
      }
    },
    "comparison": {
      "description": "Only present when the CLI ran with --compare. A before/after diff between this report and the baseline report.",
      "type": "object",
      "required": ["overall", "categories", "moved", "added", "removed", "baseline"],
      "additionalProperties": false,
      "properties": {
        "overall": {
          "type": "object",
          "required": ["before", "after", "delta", "beforeGrade", "afterGrade"],
          "additionalProperties": false,
          "properties": {
            "before": { "type": "integer", "minimum": 0, "maximum": 100 },
            "after": { "type": "integer", "minimum": 0, "maximum": 100 },
            "delta": { "type": "integer" },
            "beforeGrade": { "type": "string" },
            "afterGrade": { "type": "string" }
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "before", "after", "delta"],
            "additionalProperties": false,
            "properties": {
              "key": { "enum": ["conversion", "trust", "technical", "seo", "social", "a11y", "agent"] },
              "label": { "type": "string" },
              "before": { "type": ["integer", "null"] },
              "after": { "type": ["integer", "null"] },
              "delta": { "type": ["integer", "null"], "description": "null when only one side has a score for the category." }
            }
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "category", "before", "after", "kind"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "category": { "type": "string" },
              "before": { "type": "string" },
              "after": { "type": "string" },
              "kind": { "enum": ["improved", "regressed"] }
            }
          }
        },
        "added": {
          "type": "array",
          "description": "Checks present in this report but not in the baseline (e.g. newer tool versions).",
          "items": {
            "type": "object",
            "required": ["id", "title", "category", "status"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "category": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        },
        "removed": {
          "type": "array",
          "description": "Checks present in the baseline but not in this report.",
          "items": {
            "type": "object",
            "required": ["id", "title", "category", "status"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "category": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        },
        "baseline": {
          "type": "object",
          "required": ["url", "grade", "score", "generatedAt"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string" },
            "grade": { "type": "string" },
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "generatedAt": { "type": "string" }
          }
        }
      }
    }
  }
}
